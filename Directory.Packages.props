<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below override a vulnerable transitive dependency in every project. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Data">
    <!-- One EF Core / ASP.NET Core patch for everything (the dotnet-ef local tool matches it): mixing patches
         let HealthChecks.EntityFrameworkCore pull EF Core 10.0.14 under SqlServer 10.0.13. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <!-- Microsoft.Data.SqlClient 6.1.7 brings Pkcs 9.0.11 (GHSA-846f-f764-76mx); pin a patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Application">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Identity">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Documents">
    <!-- Server-generated files (docs/DOCUMENTS.md). QuestPDF: QuestPDF License (Community only for eligible
         organisations, otherwise Professional/Enterprise; the host requires Documents:PdfLicense). ClosedXML: MIT.
         CsvHelper: MS-PL OR Apache-2.0. -->
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>
  <ItemGroup Label="Host">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Read directly by the feature-convention architecture tests (same version NetArchTest uses). -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.3" />
  </ItemGroup>
</Project>
