    <ProjectReference Include="../../../BuildingBlocks/WarehouseERP.BuildingBlocks.Infrastructure/WarehouseERP.BuildingBlocks.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>
</Project>
